class {{ formula_class }} < Formula
  desc "{{ description }}"
  homepage "{{ homepage }}"
  url "{{ url }}"
  sha256 "{{ sha256 }}"
  version "{{ version }}"

  def install
    arch = Hardware::CPU.arm? ? "arm64" : "amd64"
    bin.install "{{ package_name }}-darwin-#{arch}" => "{{ package_name }}"
  end

  test do
    assert_match "{{ package_name }} {{ version }}", shell_output("#{bin}/{{ package_name }}")
  end
end
