class {{ formula_class }} < Formula
  desc "{{ description }}"
  homepage "{{ homepage }}"
  url "{{ url }}"
  sha256 "{{ sha256 }}"
  version "{{ version }}"
  license "GPL-3.0-or-later"
{% for dep in runtime_dependencies %}  depends_on "{{ dep }}"
{% endfor %}
  def install
    bin.install "omnipackage"
  end

  test do
    assert_match "{{ version }}", shell_output("#{bin}/omnipackage --version")
  end
end
