# Homebrew formula for the `macos` target, rendered at publish time with variables from config.yml.
class {{ formula_class }} < Formula
  desc "{{ description }}"
  homepage "{{ homepage }}"
  url "{{ url }}"
  sha256 "{{ sha256 }}"
  version "{{ version }}"
{% for dep in runtime_dependencies %}  depends_on "{{ dep }}"
{% endfor %}
  def install
    bin.install "__INIT_PACKAGE_NAME__"
  end
end
